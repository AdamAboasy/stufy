# Application
NEXT_PUBLIC_APP_NAME=Study
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Master admin activation code. Entering it at activation creates an
# admin/manager account. Only the manager holds this code.
ADMIN_ACTIVATION_CODE=27022010

# true = file-backed local store. false = live Firebase (needs Admin credentials).
USE_LOCAL_BACKEND=true
USE_FIREBASE_EMULATORS=false

FIREBASE_PROJECT_ID=study-managment-45332
FIREBASE_STORAGE_BUCKET=study-managment-45332.firebasestorage.app
FIREBASE_WEB_API_KEY=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=study-managment-45332.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://study-managment-45332-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=study-managment-45332
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=study-managment-45332.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (never expose to the browser)
# Either set these, or place serviceAccount.json in the project root.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session & code security (use long random strings in production)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CODE_PEPPER=change-me-code-pepper
CODE_ENCRYPTION_KEY=change-me-32-byte-base64-or-long-string

# First Super Admin (used only when no admin exists)
ADMIN_BOOTSTRAP_NAME=Super Admin
ADMIN_BOOTSTRAP_PHONE=+201000000000
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_Admin_123

# Optional LLM providers for document analysis (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional Firebase Cloud Messaging
FCM_VAPID_KEY=
NEXT_PUBLIC_FCM_VAPID_KEY=

# File uploads
MAX_FILE_SIZE_MB=25
