rules_version = '2';

// ============================================================
// Smart Study Planner — Firestore security rules (v2 — hardened)
// نشر: انسخ الملف كله والصقه في Console → Firestore → Rules → Publish
//
// الموديل الأمني:
//  - الأدوار في `staff/{uid}` (SUPER_ADMIN / STUDENT_ADMIN / STUDENT).
//  - أول SUPER_ADMIN بيتعمل **يدوياً** من Console (FIREBASE_SETUP.md §3) —
//    مفيش «نافذة تهيئة» مفتوحة من المتصفح بعد كده.
//  - الطالب يقدر ينشئ دور STUDENT لنفسه بس، وبعد ما ملفه موجود.
//  - إنشاء ملف طالب ذاتياً لازم يكون مربوط بكود تفعيل Active بنفس الباقة،
//    ويتعلّم Redeemed في نفس المعاملة (getAfter).
//  - حقول الاشتراك/الحالة/الصلاحيات مقفولة على الطالب؛ التجديد بكود فقط.
//
// Hardened model: first SUPER_ADMIN is created manually in the Console; a
// student can never self-assign subscription/admin fields, only redeem a
// real Active code in the same transaction/batch.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffRole() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        ? staffDoc().data.role
        : null;
    }

    function isSuperAdmin() {
      return signedIn() && staffRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return signedIn() && staffRole() in ['SUPER_ADMIN', 'STUDENT_ADMIN'];
    }

    function isSelf(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    function codePath(code) {
      return /databases/$(database)/documents/activationCodes/$(code);
    }

    // الكود المستخدم = أحدث عنصر في activationHistory (بيتحط وقت التسجيل/التجديد)
    function usedCodeId(data) {
      return data.activationHistory[0].code;
    }

    // الكود كان Active قبل العملية، واتعلّم Redeemed بنفس المستخدم بعدها،
    // وباقة الطالب = باقة الكود.
    function codeRedeemedByMeFor(plan, codeId) {
      return exists(codePath(codeId))
        && get(codePath(codeId)).data.status == 'Active'
        && getAfter(codePath(codeId)).data.status == 'Redeemed'
        && getAfter(codePath(codeId)).data.redeemedByUid == request.auth.uid
        && getAfter(codePath(codeId)).data.plan == plan;
    }

    // الحقول اللي الطالب مينفعش يغيّرها بنفسه
    function lockedStudentKeys() {
      return ['subscriptionPlan', 'subscriptionExpiryDate', 'status', 'email', 'studentId',
              'isAdmin', 'activationHistory', 'registrationDate', 'notes'];
    }

    function ownerUnchangedOrMine() {
      return request.resource.data.get('ownerUid', null) in [resource.data.get('ownerUid', null), request.auth.uid];
    }

    // ---- Staff (roles) ----
    match /staff/{uid} {
      allow read: if signedIn() && (isSuperAdmin() || request.auth.uid == uid);
      // الطالب بيربط حسابه بدور STUDENT فقط، بعد ما ملفه اتعمل
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'studentId', 'updatedAt'])
                    && request.resource.data.role == 'STUDENT'
                    && request.resource.data.studentId == uid
                    && exists(/databases/$(database)/documents/students/$(uid));
      allow create, update, delete: if isSuperAdmin();
    }

    // ---- App meta (إعدادات عامة قابلة للقراءة، الكتابة للسوبر أدمن) ----
    match /appMeta/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---- Students ----
    match /students/{studentId} {
      allow read: if isAdmin() || isSelf(studentId);

      allow create: if isAdmin()
                    || (isSelf(studentId)
                        && request.resource.data.ownerUid == request.auth.uid
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.isAdmin == false
                        && request.resource.data.status == 'Active'
                        && request.resource.data.activationHistory.size() == 1
                        && codeRedeemedByMeFor(request.resource.data.subscriptionPlan,
                                               usedCodeId(request.resource.data)));

      allow update: if isAdmin()
                    || (isSelf(studentId)
                        && ownerUnchangedOrMine()
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedStudentKeys())
                            // تجديد/ترقية بكود حقيقي (batch فيه تحديث الكود)
                            || (request.resource.data.isAdmin == resource.data.isAdmin
                                && request.resource.data.email == resource.data.email
                                && request.resource.data.studentId == resource.data.studentId
                                && request.resource.data.activationHistory.size() == resource.data.activationHistory.size() + 1
                                && codeRedeemedByMeFor(request.resource.data.subscriptionPlan,
                                                       usedCodeId(request.resource.data)))));

      allow delete: if isSuperAdmin();
    }

    // ---- Audit trail ----
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // الأدمن يكتب أي سجل؛ غير الأدمن يكتب سجلات «STUDENT» بس
      allow create: if isAdmin()
                    || (signedIn() && request.resource.data.actionSource == 'STUDENT');
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---- Activation codes ----
    // `get` مفتوح (الكود هو السر؛ الأكواد الجديدة طويلة وعشوائية بالتشفير)
    // و`list` للأدمن فقط.
    match /activationCodes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isAdmin() && request.resource.data.status == 'Revoked')
                    || (signedIn()
                        && resource.data.status == 'Active'
                        && request.resource.data.status == 'Redeemed'
                        && request.resource.data.redeemedByUid == request.auth.uid
                        && request.resource.data.code == resource.data.code
                        && request.resource.data.plan == resource.data.plan
                        && request.resource.data.durationMonths == resource.data.durationMonths
                        && request.resource.data.maxDevices == resource.data.maxDevices);
    }

    match /bookFiles/{fileId} {
      allow read, write: if false;
      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }

  }
}
