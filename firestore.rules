rules_version = '2';

// ============================================================
// Smart Study Planner — Firestore security rules (PRODUCTION)
// نشر: انسخ الملف كله والصقه في Console → Firestore → Rules → Publish
//
// الموديل الأمني:
//  - كل الكتابة/القراءة للبيانات الحساسة لازم تكون من مستخدم مسجّل (Firebase Auth).
//  - الدور بيتقرأ من مستند `staff/{uid}` (SUPER_ADMIN / STUDENT_ADMIN / STUDENT).
//  - الطالب بيشوف ويعدّل ملفه هو بس (معرّف مستنده = uid بتاعه).
//  - الأدوار العليا (staff) بيكتبها أول أدمن فقط في «نافذة التهيئة» قبل ما
//    مستند `appMeta/bootstrap` يتكتب، وبعد كده السوبر أدمن بس.
//
// Security model: every sensitive read/write needs a signed-in Firebase Auth
// user. Roles live in `staff/{uid}`. A student only touches their own
// document (doc id == uid). See FIREBASE_SETUP.md §8.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function staffRole() {
      return signedIn() ? get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role : null;
    }

    function isSuperAdmin() {
      return signedIn() && staffRole() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return signedIn() && staffRole() in ['SUPER_ADMIN', 'STUDENT_ADMIN'];
    }

    function isSelf(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }

    // نافذة التهيئة: مفتوحة بس قبل ما أول أدمن يقفلها
    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/appMeta/bootstrap);
    }

    // ---- Staff (roles) ----
    // المستخدم يقدر يقرأ دوره هو؛ السوبر أدمن يقرأ الكل ويكتب.
    match /staff/{uid} {
      allow read: if signedIn() && (isSuperAdmin() || request.auth.uid == uid);
      // أثناء التهيئة: أول مستخدم مسجّل بيحط دوره بنفسه مرة واحدة
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && bootstrapOpen()
                    && request.resource.data.role == 'SUPER_ADMIN';
      // الطالب بيسجّل نفسه STUDENT بعد إنشاء حسابه
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && !bootstrapOpen()
                    && request.resource.data.role == 'STUDENT';
      allow update, delete: if isSuperAdmin();
    }

    // ---- Bootstrap flag (كتابة لمرة واحدة) ----
    match /appMeta/{docId} {
      allow read: if true;
      // السوبر أدمن بس هو اللي بيقفل النافذة (بعد ما دوره اتسجّل)
      allow create: if signedIn()
                    && docId == 'bootstrap'
                    && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
      allow update, delete: if isSuperAdmin();
    }

    // ---- Students ----
    match /students/{studentId} {
      // الأدمن بيقرأ الكل، والطالب بيقرأ ملفه هو بس
      allow read: if isAdmin() || isSelf(studentId);
      // التسجيل الذاتي: الطالب بيكتب مستنده هو بس (id == uid)
      allow create: if isSelf(studentId)
                    && request.auth.token.email != null
                    && request.resource.data.email == request.auth.token.email.lower();
      allow create: if isAdmin();
      allow update: if isAdmin() || isSelf(studentId);
      // الحذف للسوبر أدمن فقط — حذف نهائي
      allow delete: if isSuperAdmin();
    }

    // ---- Audit trail (append-only) ----
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // أي مستخدم مسجّل يقدر يضيف سجل — والقراءة للأدمن فقط (append-only)
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Activation codes ----
    // `get` مفتوح لقراءة كود واحد (للتحقق أثناء التسجيل) لكن `list` مقفول
    // عشان محدش يسحب كل الأكواد. الطالب بيعلّم الكود Redeemed بعد التسجيل.
    match /activationCodes/{codeId} {
      allow get:  if true;
      // القراءة بالقائمة للأدمن فقط — الطالب بيستخدم get على كود واحد
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
      // استهلاك الكود: تحديث الحالة لـ Redeemed فقط
      allow update: if signedIn()
                    && request.resource.data.status == 'Redeemed'
                    && request.resource.data.code == resource.data.code;
    }

    // ---- Book files (free-plan storage fallback) ----
    // bookFiles/{fileId} + bookFiles/{fileId}/chunks/{index}
    match /bookFiles/{fileId} {
      allow read:   if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow update: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);

      match /chunks/{chunkId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/bookFiles/$(fileId)).data.ownerUid;
        }
        allow read, create, update, delete: if signedIn()
                    && (isAdmin() || parentOwner() == request.auth.uid);
      }
    }
  }
}
