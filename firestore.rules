rules_version = '2';

// ============================================================
// Smart Study Planner — Firestore security rules
// نشر: firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isSuperAdmin() {
      return role() == 'SUPER_ADMIN';
    }

    function isAdmin() {
      return role() == 'SUPER_ADMIN' || role() == 'STUDENT_ADMIN';
    }

    function isSelf(studentId) {
      return signedIn() && (request.auth.uid == studentId || request.auth.token.studentId == studentId);
    }

    // ---- Students ----
    match /students/{studentId} {
      allow read:   if signedIn() && (isAdmin() || isSelf(studentId));
      allow create: if signedIn() && (isAdmin() || isSelf(studentId));
      allow update: if signedIn() && (isAdmin() || isSelf(studentId));
      // الحذف للسوبر أدمن فقط
      allow delete: if isSuperAdmin();
    }

    // ---- Audit trail (append-only) ----
    match /auditLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Activation codes ----
    match /activationCodes/{codeId} {
      allow read:   if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- App meta / seed bookkeeping ----
    match /appMeta/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
  }
}
