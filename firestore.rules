rules_version = '2';

// ============================================================
// Smart Study Planner — Firestore security rules
// نشر: firebase deploy --only firestore:rules
//
// ⚠️ الوضع الحالي = «وضع تجريبي مفتوح» عشان التطبيق يشتغل على Cloud
// من غير Firebase Auth. ده مناسب للتطوير/العرض، ولازم يتقفل قبل
// الاستخدام الحقيقي (شوف البلوك المشروح في آخر الملف).
//
// Current mode = open (unauthenticated) so the app works on the cloud
// without Firebase Auth. Tighten it before going to production using
// the commented block at the bottom.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Students ----
    match /students/{studentId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ---- Audit trail (append-only: create allowed, update/delete blocked) ----
    match /auditLogs/{logId} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ---- Activation codes ----
    match /activationCodes/{codeId} {
      allow read, create, update, delete: if true;
    }

    // ---- App meta / health check ----
    match /appMeta/{docId} {
      allow read, write: if true;
    }
  }
}

