rules_version = '2';

// ============================================================
// Smart Study Planner — Firebase Storage rules (PRODUCTION)
// نشر: Console → Storage → Rules → Publish (أو firebase deploy --only storage)
//
// - كل العمليات لازم تكون من مستخدم مسجّل (Firebase Auth).
// - الطالب بيقرأ/يكتب ملفاته هو بس: books/{uid}/...
// - الأدوار بتتقرأ من Firestore (staff/{uid}) — نفس موديل firestore.rules.
// - حد أقصى 200MB للملف.
//
// ملاحظة: Firebase Storage على الخطة المجانية (Spark) محتاج Blaze للتفعيل.
// لو Storage مش متفعل، التطبيق بيستخدم بديل Firestore (bookFiles) تلقائياً.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function staffRole() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return staffRole() in ['SUPER_ADMIN', 'STUDENT_ADMIN'];
    }

    match /books/{studentId}/{fileName} {
      allow read:   if signedIn() && (isAdmin() || request.auth.uid == studentId);
      allow write:  if signedIn()
                    && (isAdmin() || request.auth.uid == studentId)
                    && request.resource.size < 200 * 1024 * 1024;
      allow delete: if signedIn() && (isAdmin() || request.auth.uid == studentId);
    }

    // أي مسار آخر: ممنوع
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
