rules_version = '2';

// ============================================================
// Smart Study Planner — Firebase Storage rules
// نشر: firebase deploy --only storage
// اسمح بحد أقصى 200 ميجابايت للملف الواحد ومن نوع PDF
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'SUPER_ADMIN' || role() == 'STUDENT_ADMIN';
    }

    // books/{studentId}/{file}.pdf
    match /books/{studentId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == studentId);
      allow write: if signedIn()
                   && (isAdmin() || request.auth.uid == studentId)
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if signedIn() && (isAdmin() || request.auth.uid == studentId);
    }
  }
}
