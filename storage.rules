rules_version = '2';

// ============================================================
// Smart Study Planner — Firebase Storage rules
// نشر: firebase deploy --only storage
//
// ⚠️ الوضع الحالي = مفتوح عشان رفع الكتب يشتغل من غير Firebase Auth.
// Open mode so PDF uploads work without Firebase Auth.
// نسخة الإنتاج المشدّدة موجودة في آخر الملف.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    match /books/{studentId}/{fileName} {
      allow read:   if true;
      allow write:  if request.resource == null
                    || (request.resource.size < 200 * 1024 * 1024);
      allow delete: if true;
    }

    // أي مسار آخر: ممنوع
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

