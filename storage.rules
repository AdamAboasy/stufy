rules_version = '2';

// ============================================================
// Smart Study Planner — Firebase Storage rules
// نشر: Console → Storage → Rules → Publish (أو firebase deploy --only storage)
//
// ⚠️ التطبيق مبقى بيرفع ملفات: رفع الكتب اتشال بالكامل، وكل البيانات
// (الطلاب، الأكواد، الخطط) بقت مستندات Firestore فقط.
// القواعد دي بتقفل كل المسارات (*) — يعني حتى لو حد عنده الـ SDK مش هيقدر
// يرفع أو يقرأ أي ملف من الـ bucket.
//
// Uploads were removed from the app; every path is denied by design.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
