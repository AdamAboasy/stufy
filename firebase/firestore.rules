rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && request.auth.token.role == 'admin';
    }

    function isStudent() {
      return signedIn()
        && request.auth.token.role == 'student';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStudentOwner(studentId) {
      return isStudent() && isOwner(studentId);
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if isStudentOwner(studentId) || isAdmin();

      allow create: if false;
      allow update: if isStudentOwner(studentId)
        && unchanged(['role', 'subscription', 'admin', 'accountStatus', 'uid', 'phoneNumber'])
        && !request.resource.data.keys().hasAny(['role', 'admin']);
      allow delete: if false;

      match /settings/{docId} {
        allow read: if isStudentOwner(studentId) || isAdmin();
        allow write: if isStudentOwner(studentId);
      }

      match /{subcollection}/{docId} {
        allow read: if isStudentOwner(studentId) || isAdmin();
        allow write: if false;
      }
    }

    match /activationCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /devices/{deviceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /deviceChangeRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if signedIn()
        && isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isAdmin();
    }

    match /uploadedFiles/{fileId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /fileProcessingJobs/{jobId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /studyPlans/{planId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /studyTasks/{taskId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /routines/{routineId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /studySessions/{sessionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /passwordRecoveryRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
