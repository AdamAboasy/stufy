rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Custom claims set by the trusted Functions backend are the only admin authority.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'super_admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Student profile at users/{uid}. Profile data is not an authorization source.
    match /users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'phoneNumber', 'role', 'educationLevel', 'academicGrade',
          'universityName', 'faculty', 'academicYear', 'otherAcademicLevel', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'educationLevel', 'academicGrade', 'universityName', 'faculty',
          'academicYear', 'otherAcademicLevel', 'updatedAt'
        ]);
      allow delete: if false;

      // Student-owned app collections remain isolated. File processing fields are backend-owned.
      match /{collection}/{document=**} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && collection != 'files';
      }

      match /files/{fileId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.studentId == uid
          && request.resource.data.storagePath == 'users/' + uid + '/files/' + fileId
          && request.resource.data.processingStatus == 'uploaded';
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originalName', 'updatedAt']);
        allow delete: if isOwner(uid);
      }
    }

    // Platform academic choices can be read during registration. Writes are admin-claim only.
    match /configuration/{document} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
